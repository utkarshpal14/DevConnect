# ============================================================
# DevConnect Backend — Production Environment Variables
# Hosting: Render Web Service
# ============================================================

# Runtime Environment
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/devconnect?retryWrites=true&w=majority

# JWT Authentication
# Render generates this automatically if using render.yaml
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Redis Cloud Connection String
# Replace with your Redis Cloud endpoint and password
REDIS_URL=redis://:<redis_password>@<redis_host>:<redis_port>

# AI Microservice URL (Render Web Service)
AI_SERVICE_URL=https://devconnect-ai-service.onrender.com

# Frontend Domain (Vercel deployment URL for CORS & Socket.IO)
FRONTEND_URL=https://dev-connect-eight-psi.vercel.app

# Transactional Email (Gmail or Brevo SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="DevConnect <your_email@gmail.com>"
